# ==============================================================================
# RecoverAI Frontend - Production & Local Environment Configuration
# ==============================================================================

# Backend API Endpoint (Standardized across all environments)
# Production: Set to your live Render/custom backend URL (e.g. https://api.recoverai.io)
# Local: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Supabase Authentication & Workspace Access
# Required in production. Do not commit publishable keys to public repositories.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Payment Gateway - Razorpay Test Mode
# Required for Demo Checkout. Only keys starting with 'rzp_test_' are permitted.
VITE_RAZORPAY_KEY_ID=rzp_test_your_test_key_here
