# ==============================================================================
# RecoverAI Backend - Production Environment Configuration Template
# ==============================================================================

# Core Application Settings
# In production on Render/Cloud: set ENVIRONMENT=production and DEBUG=false
# In local development: set ENVIRONMENT=development and DEBUG=true
ENVIRONMENT=production
DEBUG=false

PROJECT_NAME="RecoverAI API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# CORS Configuration (JSON array of allowed origins)
# Example: ["https://recoverai.vercel.app","http://localhost:3000"]
CORS_ORIGINS=["https://your-frontend.vercel.app","http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database (Supabase / Managed PostgreSQL)
# In production, SQLite is strictly forbidden. A valid PostgreSQL connection string is required.
DATABASE_URL=postgresql://postgres.your_project:your_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Auth & JWT Verification
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_service_role_secret_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_secret_here
SUPABASE_JWKS_URL=https://your_project.supabase.co/auth/v1/.well-known/jwks.json

# Payment Gateway - Razorpay Test Mode
# For hackathon security, only test keys starting with 'rzp_test_' are permitted.
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# AI & LLM Engine - Google Gemini SDK
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
